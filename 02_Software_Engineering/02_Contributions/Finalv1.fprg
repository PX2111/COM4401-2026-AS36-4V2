<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Prototype"/>
        <attribute name="authors" value="HM11CRT"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-01 11:36:51 AM"/>
        <attribute name="created" value="SE0xMUNSVDtBTVRDMjEzLTA3OzIwMjYtMDktMjk7MDk6Mjg6NTYgQU07MjM2MA=="/>
        <attribute name="edited" value="SE0xMUNSVDtBTVRDMjEzLTA3OzIwMjYtMDktMjk7MDI6NTc6MzEgUE07MjsyNDcy"/>
        <attribute name="edited" value="SG0xMUNydDtBTVRDMjEzLTA3OzIwMjYtMTAtMDE7MTA6NTY6NTkgQU07MTtmdXJpb3VzYXR1cm47QU5EUkVXUEM7MjAyNi0wOS0yNTswMzoxNjozNiBQTTtzdXBlckNhclByb2JsZW0uZnByZzs3OTE1"/>
        <attribute name="edited" value="SG0xMUNydDtBTVRDMjEzLTA3OzIwMjYtMTAtMDE7MTE6MzY6NTEgQU07MTA7MjU4MQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Setup Variables"/>
            <declare name="customerDetails" type="String" array="True" size="3"/>
            <declare name="NumOfPizza" type="Integer" array="False" size=""/>
            <declare name="SizeOfPizzas" type="Real" array="True" size="6"/>
            <declare name="NumOfToppings" type="Real" array="True" size="6"/>
            <declare name="IsDelivery" type="Boolean" array="False" size=""/>
            <comment text="One Vars are set, Call GetCustomerDetails Subroutine. &#13;&#10;"/>
            <call expression="getCustomerDetails(customerDetails)&#13;&#10;"/>
            <comment text="This sets the variable of 'NumOfPizza' using the 'getNumPizzas' subroutine"/>
            <assign variable="NumOfPizza" expression="getNumPizzas()"/>
            <comment text="Subroutine that sets the Pizza Size and Toppings"/>
            <call expression="pizzaDetails(NumOfPizza,SizeOfPizzas,NumOfToppings)"/>
            <assign variable="IsDelivery" expression="checkDelivery()"/>
            <comment text="Display Bill&#13;&#10;"/>
            <call expression="displayBill(NumOfPizza,SizeOfPizzas,NumOfToppings,IsDelivery)"/>
        </body>
    </function>
    <function name="checkBlank" type="String" variable="checker">
        <parameters>
            <parameter name="checker" type="String" array="False"/>
        </parameters>
        <body>
            <comment text="Converts the current string stored in customer details to character code to check if its correct"/>
            <while expression="ToCode(Char(checker &amp; &quot; &quot;,0)) = 32">
                <output expression="&quot;This cannot be blank, try again!&quot;" newline="True"/>
                <input variable="checker"/>
            </while>
        </body>
    </function>
    <function name="checkDelivery" type="Boolean" variable="Check">
        <parameters/>
        <body>
            <declare name="Check" type="Boolean" array="False" size=""/>
            <output expression="&quot;Is this order going to be delivered? True or false only please.&quot;" newline="True"/>
            <input variable="Check"/>
        </body>
    </function>
    <function name="displayBill" type="None" variable="">
        <parameters>
            <parameter name="NumOfPizza" type="Integer" array="False"/>
            <parameter name="SizeOfPizza" type="Real" array="True"/>
            <parameter name="NumOfToppings" type="Real" array="True"/>
            <parameter name="IsDelivery" type="Boolean" array="False"/>
        </parameters>
        <body>
            <declare name="Sum" type="Real" array="False" size=""/>
            <declare name="PreSum" type="Real" array="False" size=""/>
            <assign variable="Sum" expression="0.00"/>
            <comment text="The Do Loop itterates through each pizza size and topping and adds it to the sum"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="i" expression="0"/>
            <do expression="NumOfPizza &gt; i">
                <assign variable="Sum" expression="Sum + SizeOfPizza[i]"/>
                <assign variable="Sum" expression="Sum + NumOfToppings[i]"/>
                <assign variable="i" expression="i + 1"/>
            </do>
            <comment text="Checks for discount if sum &gt; 20 before delivery"/>
            <assign variable="PreSum" expression="Sum"/>
            <if expression="Sum &gt; 20">
                <then>
                    <output expression="&quot;Discount has been added to order&quot;" newline="True"/>
                    <assign variable="Sum" expression="Sum * 0.9"/>
                    <output expression="&quot;Discount Ammount = &#163;&quot; &amp; PreSum - Sum" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Discount not earned for order&quot;" newline="True"/>
                </else>
            </if>
            <comment text="Checks if delivery has been selected"/>
            <if expression="IsDelivery = True">
                <then>
                    <assign variable="Sum" expression="Sum + 2.50"/>
                </then>
                <else/>
            </if>
            <output expression="&quot;Order Total = &#163;&quot; &amp; Sum" newline="True"/>
        </body>
    </function>
    <function name="getCustomerDetails" type="None" variable="">
        <parameters>
            <parameter name="customerDetails" type="String" array="True"/>
        </parameters>
        <body>
            <comment text="This subroutine sets the details as such: &#13;&#10;CustomerDetails[0]= Name&#13;&#10;CustomerDetails[1]= Address&#13;&#10;CustomerDetails[2]= Phone Number&#13;&#10;"/>
            <declare name="assign" type="String" array="True" size="3"/>
            <assign variable="assign[0]" expression="&quot;Name&quot;"/>
            <assign variable="assign[1]" expression="&quot;Address&quot;"/>
            <assign variable="assign[2]" expression="&quot;Phone Num&quot;"/>
            <comment text="Settup a for loop that itterates through customer details gathering the data for each feild recursively"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="2" direction="inc" step="1">
                <output expression="&quot;Enter &quot; &amp; assign[i] &amp; &quot;  :&quot;" newline="True"/>
                <input variable="customerDetails[i]"/>
                <assign variable="customerDetails[i]" expression="checkBlank(customerDetails[i])"/>
            </for>
        </body>
    </function>
    <function name="getNumPizzas" type="Integer" variable="noOfPizzas">
        <parameters/>
        <body>
            <declare name="noOfPizzas" type="Integer" array="False" size=""/>
            <assign variable="noOfPizzas" expression="0"/>
            <output expression="&quot;Enter number of pizzas(max 6)&quot;" newline="True"/>
            <while expression="noOfPizzas &lt; 1 OR noOfPizzas &gt; 6">
                <input variable="noOfPizzas"/>
                <if expression="noOfPizzas &lt; 1 OR noOfPizzas &gt; 6">
                    <then>
                        <output expression="&quot;Error, must order minimum 1 and maximum 6 pizzas&quot;" newline="True"/>
                    </then>
                    <else>
                        <output expression="&quot;Ok, you've selected &quot; &amp; noOfPizzas &amp; &quot; pizzas.&quot;" newline="True"/>
                    </else>
                </if>
            </while>
        </body>
    </function>
    <function name="PizzaDetails" type="None" variable="">
        <parameters>
            <parameter name="NumOfPizza" type="Integer" array="False"/>
            <parameter name="SizeOfPizzas" type="Real" array="True"/>
            <parameter name="NumOfToppings" type="Real" array="True"/>
        </parameters>
        <body>
            <declare name="count" type="Integer" array="False" size=""/>
            <assign variable="count" expression="0"/>
            <comment text="Iterative Do loop that goes though each pizza's details"/>
            <do expression="count &lt; NumOfPizza">
                <comment text="Function that sets the size of pizza"/>
                <assign variable="SizeOfPizzas[count]" expression="setSizeOfPizzas(count)"/>
                <comment text="Function that sets number of toppings"/>
                <assign variable="NumOfToppings[count]" expression="setToppings(count)"/>
                <output expression="&quot;The cost for pizza &quot; &amp; count + 1 &amp; &quot; is: &#163;&quot; &amp; NumOfToppings[count] + SizeOfPizzas[count]" newline="True"/>
                <assign variable="count" expression="count+1"/>
                <comment text="keep running till count reaches the number of pizzas"/>
            </do>
        </body>
    </function>
    <function name="setSizeOfPizzas" type="Real" variable="Cost">
        <parameters>
            <parameter name="Count" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="sizeVal" type="Integer" array="False" size=""/>
            <declare name="label" type="String" array="False" size=""/>
            <declare name="Cost" type="Real" array="False" size=""/>
            <assign variable="Cost" expression="0"/>
            <output expression="&quot;Select a size pizza you would like for pizza &#8470;&quot; &amp; count + 1" newline="True"/>
            <do expression="sizeVal &gt; 3 OR sizeVal &lt; 1">
                <output expression="&quot;1 = Small 2 = Medium 3 = Large&quot;" newline="True"/>
                <input variable="sizeVal"/>
                <if expression="sizeVal &gt; 3 OR sizeVal &lt; 1">
                    <then>
                        <output expression="&quot;Error: size must be within range&quot;" newline="True"/>
                    </then>
                    <else>
                        <if expression="sizeVal = 1">
                            <then>
                                <assign variable="Cost" expression="Cost + 3.25"/>
                                <assign variable="label" expression="&quot;small&quot;"/>
                            </then>
                            <else>
                                <if expression="sizeVal = 2">
                                    <then>
                                        <assign variable="Cost" expression="Cost + 5.50"/>
                                        <assign variable="label" expression="&quot;medium&quot;"/>
                                    </then>
                                    <else>
                                        <assign variable="Cost" expression="Cost + 7.15"/>
                                        <assign variable="label" expression="&quot;large&quot;"/>
                                    </else>
                                </if>
                            </else>
                        </if>
                        <output expression="&quot;Ok for pizza &quot; &amp; count + 1 &amp; &quot; the size is: &quot; &amp; label &amp; &quot;.&quot;" newline="True"/>
                    </else>
                </if>
            </do>
        </body>
    </function>
    <function name="setToppings" type="Real" variable="Cost">
        <parameters>
            <parameter name="count" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="Val" type="Integer" array="False" size=""/>
            <declare name="Cost" type="Real" array="False" size=""/>
            <output expression="&quot;Select how many extra toppings for pizza no&quot; &amp; count + 1" newline="True"/>
            <do expression="Val &lt; 0">
                <input variable="Val"/>
                <if expression="Val &lt; 0">
                    <then>
                        <output expression="&quot;Error, You cant have negative toppings!&quot;" newline="True"/>
                    </then>
                    <else>
                        <if expression="Val &gt;= 4">
                            <then>
                                <assign variable="Cost" expression="2.50"/>
                            </then>
                            <else>
                                <if expression="Val = 3">
                                    <then>
                                        <assign variable="Cost" expression="2.00"/>
                                    </then>
                                    <else>
                                        <if expression="Val = 2">
                                            <then>
                                                <assign variable="Cost" expression="1.35"/>
                                            </then>
                                            <else>
                                                <assign variable="Cost" expression="0.75"/>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
                <output expression="&quot;Ok you've selected &quot; &amp; val &amp; &quot; extra toppings&quot;" newline="True"/>
            </do>
        </body>
    </function>
</flowgorithm>
