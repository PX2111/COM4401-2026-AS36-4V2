-- THIS IS JUST FOR EXAMPLE: REPLACE WITH REAL WORKSTATIONBUILDS TABLE
CREATE TABLE WorkstationBuilds (
  BuildID INTEGER AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(100) NOT NULL
);


-- create BuildItems
CREATE TABLE BuildItems (
  ItemID INTEGER AUTO_INCREMENT PRIMARY KEY,
  BuildID INTEGER,
  HardwareCategory VARCHAR(50) NOT NULL,
  ItemName VARCHAR(100) NOT NULL,
  Specification VARCHAR(150) NOT NULL,
  Cost DECIMAL(8,2) NOT NULL,
  FOREIGN KEY (BuildID)
  REFERENCES WorkstationBuilds(BuildID)

ON UPDATE CASCADE
ON DELETE CASCADE
);

