CREATE TABLE WorkstationBuilds (
BuildID INT AUTO_INCREMENT PRIMARY KEY,
RoleID INT NOT NULL,
BuildName VARCHAR(100) NOT NULL,
Source VARCHAR(50),

CONSTRAINT FK_WorkstationBuilds_Role
FOREIGN KEY (RoleID)
REFERENCES EmployeeRoles(RoleID)
ON UPDATE CASCADE
ON DELETE CASCADE
) ENGINE=InnoDB 

