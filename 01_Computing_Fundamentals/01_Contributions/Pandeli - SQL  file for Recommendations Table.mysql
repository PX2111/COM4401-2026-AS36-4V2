CREATE TABLE Recommendations (
 RecommendationID INT PRIMARY KEY,
 RoleID INT,
 Justification TEXT,
 Compromise TEXT,
 Approved BOOLEAN,
 EthicalNotes TEXT,
 FOREIGN KEY(RoleID) REFERENCES EmployeeRoles(RoleID)
 );

